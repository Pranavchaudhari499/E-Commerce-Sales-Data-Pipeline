# ==============================================================================
# E-commerce ETL Pipeline — environment configuration
# Copy this file to `.env` and adjust values for your machine.
# ==============================================================================

# --- Database engine ---------------------------------------------------------
# Choose ONE:
#   sqlite  -> zero-install local database (great for a quick local demo)
#   postgresql -> production-grade engine used by the Docker setup
DB_ENGINE=sqlite

# --- Path to the SQLite database file (only used when DB_ENGINE=sqlite) ------
SQLITE_DB_PATH=data/processed/sales.db

# --- PostgreSQL connection (only used when DB_ENGINE=postgresql) -------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce

# --- Input data ---------------------------------------------------------------
# Raw transaction file to load. If it does not exist the pipeline will
# generate a fresh synthetic dataset first.
RAW_TRANSACTIONS=data/raw/transactions.csv

# --- Pipeline options ----------------------------------------------------------
# Number of rows to generate when creating a fresh synthetic dataset.
GENERATE_ROWS=100000

# A fixed seed so the synthetic dataset is reproducible.
RANDOM_SEED=42
